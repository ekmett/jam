@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/jamTargets.cmake")
if(APPLE AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  block()
    # Select the consumer compiler's runtime; never retain the producer's path.
    get_filename_component(jam_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    set(jam_libcxx "${jam_compiler_bin}/../lib/c++")
    if(EXISTS "${jam_libcxx}/libc++.dylib")
      target_link_directories(jam::jam INTERFACE "${jam_libcxx}")
    endif()
  endblock()
endif()
check_required_components(jam)
