+        @SuppressWarnings("this-escape")
+        public Templates(OptionValues options, Providers providers, SubstrateAllocationSnippets.Templates baseTemplates) {
+            super(options, providers);
+            this.baseTemplates = baseTemplates;
+            formatObject = snippet(providers, JamAllocationSnippets.class, "formatObjectSnippet");
+            formatArray = snippet(providers, JamAllocationSnippets.class, "formatArraySnippet");
+            formatStoredContinuation = ContinuationSupport.isSupported() ? snippet(providers, JamAllocationSnippets.class, "formatStoredContinuation") : null;
