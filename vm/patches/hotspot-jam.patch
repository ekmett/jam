+class JamFinalizers : public VoidClosure {
+  JamScanState* _state;
+public:
+  explicit JamFinalizers(JamScanState* state) : _state(state) {}
+  void do_void() override {
+    jam_vm_weak_finalizers(_state->heap->jam(), jam_scan, _state);
+  }
+};
+
+class JamRefProc : public RefProcProxyTask {
+  JamKeepAlive _keep_alive;
+  JamComplete _complete;
+public:
+  JamRefProc() : RefProcProxyTask("JamRefProc", 1) {}
+  void work(uint worker_id) override {
+    assert(worker_id == 0, "VM reference processing is serial");
+    BarrierEnqueueDiscoveredFieldClosure enqueue;
+    _rp_task->rp_work(0, &jam_is_alive, &_keep_alive, &enqueue, &_complete);
+  }
+};
+
+class JamAdjust : public OopClosure {
+  template<class T> void apply(T* p) {
+    T value = RawAccess<>::oop_load(p);
+    if (CompressedOops::is_null(value)) return;
+    uint32_t at = CompressedOops::narrow_oop_value(value);
+    uint32_t next = jam_vm_forward(JamHeap::heap()->jam(), at);
+    oop target = next == 0 ? nullptr : cast_to_oop(CompressedOops::base() + size_t(next) * HeapWordSize);
+    RawAccess<>::oop_store(p, target);
+  }
+public:
+  void do_oop(oop* p) override { apply(p); }
+  void do_oop(narrowOop* p) override { apply(p); }
+};
+
+static void jam_roots(OopClosure* closure, bool adjust) {
+  StrongRootsScope scope(0);
+  CLDToOopClosure clds(closure, ClassLoaderData::_claim_none);
+  NMethodToOopClosure code(closure, adjust);
+  ClassLoaderDataGraph::cld_do(&clds);
+  // The full code-cache traversal below owns all nmethod slots.
+  Threads::oops_do(closure, nullptr);
+  OopStorageSet::strong_oops_do(closure);
+  CodeCache::nmethods_do(&code);
+}
+
+class VM_JamCollect : public VM_GC_Operation {
+  bool _minor;
+  bool _promote;
+public:
+  VM_JamCollect(uint count, uint full_count, GCCause::Cause cause, bool minor, bool promote)
+    : VM_GC_Operation(count, cause, full_count, !minor), _minor(minor), _promote(promote) {}
+  VMOp_Type type() const override { return VMOp_JamCollect; }
+  void doit() override {
+    JamHeap* heap = JamHeap::heap();
+    GCCauseSetter cause(heap, _gc_cause);
+    heap->do_collection(_minor, _promote,
+                        !_minor && (_gc_cause == GCCause::_allocation_failure ||
+                                     _gc_cause == GCCause::_metadata_GC_clear_soft_refs));
+  }
+};
+
+HeapWord* JamHeap::allocate_or_collect_work(size_t size, bool tlab, bool verbose) {
+  bool young = size <= _young_space->capacity() / HeapWordSize;
+  if (tlab && !young) return nullptr;
+  HeapWord* result = allocate_work(size, young, verbose);
+  if (result == nullptr && is_init_completed()) {
+    if (young) {
+      bool promote;
+      {
+        MutexLocker ml(Heap_lock);
+        promote = (_minor_collections + 1) % JamPromoteEvery == 0;
+      }
+      collect_generation(true, promote, GCCause::_allocation_failure);
+      result = allocate_work(size, true, verbose);
+    }
+    if (result == nullptr) {
+      collect_generation(false, false, GCCause::_allocation_failure);
+      result = allocate_work(size, young, verbose);
+    }
+  }
+  if (result == nullptr && young && !tlab) result = allocate_work(size, false, verbose);
+  return result;
+}
+
+void JamHeap::pin_object(JavaThread* thread, oop obj) { GCLocker::enter(thread); }
+void JamHeap::unpin_object(JavaThread* thread, oop obj) { GCLocker::exit(thread); }
+
+void JamHeap::collect(GCCause::Cause cause) {
+  collect_generation(false, false, cause);
+}
+
+void JamHeap::collect_generation(bool minor, bool promote, GCCause::Cause cause) {
+  if (SafepointSynchronize::is_at_safepoint()) {
+    GCCauseSetter cause_scope(this, cause);
+    do_collection(minor, promote, !minor && cause == GCCause::_metadata_GC_clear_soft_refs);
+    return;
+  }
+  uint count;
+  uint full_count;
+  {
+    MutexLocker ml(Heap_lock);
+    count = total_collections();
+    full_count = total_full_collections();
+  }
+  VM_JamCollect operation(count, full_count, cause, minor, promote);
+  VMThread::execute(&operation);
+}
+
+void JamHeap::do_full_collection(bool clear_all_soft_refs) {
+  do_collection(false, false, clear_all_soft_refs);
+}
+
+size_t JamHeap::collections(int kind) const {
+  assert(Heap_lock->owned_by_self(), "Counters require the heap lock");
+  return kind == 0 ? _minor_collections : kind == 1 ? _promotions : _major_collections;
+}
+
+void JamHeap::do_collection(bool minor, bool promote, bool clear_all_soft_refs) {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must stop mutators");
+  assert(Heap_lock->is_locked(), "Must serialize heap operations");
+  assert(!GCLocker::is_active(), "Must wait for JNI critical regions");
+  IsSTWGCActiveMark active;
+  SvcGCMarker marker(minor ? SvcGCMarker::MINOR : SvcGCMarker::FULL);
+  GCIdMark gc_id;
+  STWGCTimer timer;
+  timer.register_gc_start();
+  GCTraceTime(Info, gc) time(minor ? "Jam minor collection" : "Jam major collection", nullptr, gc_cause(), true);
+  increment_total_collections(!minor);
+  const bool should_verify = total_collections() >= VerifyGCStartAt;
+  if (should_verify && VerifyBeforeGC) {
+    prepare_for_verify();
+    Universe::verify("Before GC");
+  }
+  ensure_parsability(true);
+  COMPILER2_OR_JVMCI_PRESENT(DerivedPointerTable::clear());
+
+  JamScanState state(this, minor);
+  _jam_scan_state = &state;
+  jam_vm_begin(_jam, minor);
+  _ref_processor->start_discovery(clear_all_soft_refs);
+  if (minor) trace_dirty_owners();
+  jam_vm_weak_roots(_jam, jam_scan, &state);
+  JamRoots roots;
+  jam_roots(&roots, false);
+  roots.trace(this);
+  jam_vm_weak_close(_jam, jam_scan, &state);
+
+  JamRefProc task;
+  JamFinalizers finalizers(&state);
+  ReferenceProcessorPhaseTimes ref_times(&timer, _ref_processor->max_num_queues());
+  _ref_processor->process_discovered_references(task, ref_times, &finalizers);
+  ref_times.print_all_references();
+  DoNothingClosure noop;
+  WeakProcessor::weak_oops_do(&jam_is_alive, &noop);
+
+  bool promoted = minor && promote;
+  if (!jam_vm_prepare(_jam, promoted)) {
+    guarantee(promoted, "Only insufficient promotion space can fail preparation");
+    promoted = false;
+    guarantee(jam_vm_prepare(_jam, false), "In-generation compaction must fit");
+  }
+  COMPILER2_OR_JVMCI_PRESENT(DerivedPointerTable::set_active(false));
+  JamAdjust adjust;
+  jam_roots(&adjust, true);
+  WeakProcessor::oops_do(&adjust);
+  _ref_processor->weak_oops_do(&adjust);
+  for (int i = 0; i < state.wide_slots.length(); ++i) {
+    adjust.do_oop(state.wide_slots.at(i));
+  }
+  for (int i = 0; i < state.old_slots.length(); ++i) {
+    adjust.do_oop(state.old_slots.at(i));
+  }
+  jam_vm_finish(_jam);
+  _space->set_top((HeapWord*)(CompressedOops::base() + jam_vm_used(_jam, false) * HeapWordSize));
+  _young_space->set_top((HeapWord*)(CompressedOops::base() + jam_young_displacement +
+                                   jam_vm_used(_jam, true) * HeapWordSize));
+  // Promoted bases must be inside the published old space before validation.
+  COMPILER2_OR_JVMCI_PRESENT(DerivedPointerTable::update_pointers());
+  if (!minor || promoted) rebuild_old_metadata(!minor);
+  if (minor) ++_minor_collections; else ++_major_collections;
+  if (promoted) ++_promotions;
+  log_debug(gc)("Jam collections: minor=%zu, promotion=%zu, major=%zu; old=%zu, young=%zu bytes",
+                _minor_collections, _promotions, _major_collections, _space->used(), _young_space->used());
+  _jam_scan_state = nullptr;
+  resize_all_tlabs();
+  update_capacity_and_used_at_gc();
+  if (!minor) record_whole_heap_examined_timestamp();
+  MetaspaceGC::compute_new_size();
+  _last_counter_update = used();
+  _last_heap_print = used();
+  _monitoring_support->update_counters();
+  if (should_verify && VerifyAfterGC) Universe::verify("After GC");
+  timer.register_gc_end();
+}
+
+void JamHeap::prepare_for_verify() { ensure_parsability(false); }
+
+void JamHeap::verify(VerifyOption option) {
+  // Existing VM verifier checks every object's class/fields and that the final
+  // object boundary equals top(), in addition to Universe's external roots.
+  _space->verify();
+  _young_space->verify();
+  JamRemember cards(this, _card_table, true);
+  for (HeapWord* object = _space->bottom(); object < _space->top();) {
+    oop value = cast_to_oop(object);
+    cards.set_owner(value);
+    value->oop_iterate(&cards);
+    object += value->size();
+  }
+}
