+size_t JamArguments::conservative_max_heap_alignment() {
+  return MAX2(size_t(UseLargePages ? os::large_page_size() : os::vm_page_size()),
+              size_t(CardTable::ct_max_alignment_constraint()));
+}
+
+void JamArguments::initialize() {
+  GCArguments::initialize();
+
+  assert(UseJamGC, "Sanity");
+
+  if (!UseCompressedOops || ObjectAlignmentInBytes != 8 || UseLargePages ||
+      UseCompactObjectHeaders || AllocateHeapAt != nullptr) {
+    vm_exit_during_initialization("Jam requires compressed oops, eight-byte alignment, ordinary headers and normal anonymous pages");
+  }
+  if (InitialHeapSize != MaxHeapSize) {
+    vm_exit_during_initialization("Jam requires a fixed heap: use equal -Xms and -Xmx");
+  }
+  if (FLAG_IS_DEFAULT(HeapBaseMinAddress)) {
+    // A non-default origin makes the reserver attempt this exact address.
+    // macOS can reject low disjoint addresses and return a zero-based heap;
+    // prefer 2 TiB there, then validate the actual encoding after reservation.
+#ifdef __APPLE__
+    FLAG_SET_ERGO(HeapBaseMinAddress, size_t(1) << 41);
+#else
+    FLAG_SET_ERGO(HeapBaseMinAddress, 32 * G);
+#endif
+  }
+  if (FLAG_IS_DEFAULT(ClassUnloading)) {
+    FLAG_SET_DEFAULT(ClassUnloading, false);
+  }
+  if (ClassUnloading) {
+    vm_exit_during_initialization("Jam does not yet support class unloading");
+  }
+
+  if (JamMaxTLABSize < MinTLABSize) {
+    log_warning(gc)("JamMaxTLABSize < MinTLABSize, adjusting it to %zu", MinTLABSize);
+    JamMaxTLABSize = MinTLABSize;
+  }
+
+  if (!JamElasticTLAB && JamElasticTLABDecay) {
+    log_warning(gc)("Disabling JamElasticTLABDecay because JamElasticTLAB is disabled");
+    FLAG_SET_DEFAULT(JamElasticTLABDecay, false);
+  }
+
+#ifdef COMPILER2
+  // Enable loop strip mining: there are still non-GC safepoints, no need to make it worse
+  if (FLAG_IS_DEFAULT(UseCountedLoopSafepoints)) {
+    FLAG_SET_DEFAULT(UseCountedLoopSafepoints, true);
+    if (FLAG_IS_DEFAULT(LoopStripMiningIter)) {
+      FLAG_SET_DEFAULT(LoopStripMiningIter, 1000);
+    }
+  }
+#endif
+}
+
+void JamArguments::initialize_alignments() {
+  CardTable::initialize_card_size();
+  size_t page_size = UseLargePages ? os::large_page_size() : os::vm_page_size();
+  size_t align = MAX3(os::vm_allocation_granularity(), page_size, CardTable::ct_max_alignment_constraint());
+  SpaceAlignment = align;
+  HeapAlignment  = align;
+}
+
+CollectedHeap* JamArguments::create_heap() {
+  return new JamHeap();
+}
