+
+public class JamHeap extends CollectedHeap {
+
+  private static AddressField spaceField;
+  private static AddressField youngSpaceField;
+  private ContiguousSpace space;
+  private ContiguousSpace youngSpace;
+
+  static {
+    VM.registerVMInitializedObserver(new Observer() {
+        public void update(Observable o, Object data) {
+          initialize(VM.getVM().getTypeDataBase());
+        }
+      });
+  }
+
+  private static void initialize(TypeDataBase db) {
+    Type type = db.lookupType("JamHeap");
+    spaceField = type.getAddressField("_space");
+    youngSpaceField = type.getAddressField("_young_space");
+  }
+
+  public JamHeap(Address addr) {
+    super(addr);
+    space = new ContiguousSpace(spaceField.getValue(addr));
+    youngSpace = new ContiguousSpace(youngSpaceField.getValue(addr));
+  }
+
+  @Override
+  public CollectedHeapName kind() {
+    return CollectedHeapName.JAM;
+  }
+
+  @Override
+  public long capacity() {
+    return space.capacity() + youngSpace.capacity();
+  }
+
+  @Override
+  public long used() {
+    return space.used() + youngSpace.used();
+  }
+
+  public ContiguousSpace space() {
+    return space;
+  }
+
+  public ContiguousSpace youngSpace() {
+    return youngSpace;
+  }
+
+  @Override
+  public void liveRegionsIterate(LiveRegionsClosure closure) {
+    closure.doLiveRegions(space());
+    closure.doLiveRegions(youngSpace());
+  }
+
+  @Override
+  public void printOn(PrintStream tty) {
+     MemRegion mr = reservedRegion();
+     tty.println("Jam heap");
+     tty.println(" reserved:  [" + mr.start() + ", " + mr.end() + "]");
+     tty.println(" old:       [" + space.bottom() + ", " + space.top() + ", " + space.end() + "]");
+     tty.println(" young:     [" + youngSpace.bottom() + ", " + youngSpace.top() + ", " + youngSpace.end() + "]");
+  }
+
+}
