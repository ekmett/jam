+// The VM describes objects and policy; jam owns marking queues and relocation.
+struct JamScanState {
+  JamHeap* heap;
+  bool minor;
+  GrowableArray<oop*> wide_slots;
+  GrowableArray<narrowOop*> old_slots;
+  JamScanState(JamHeap* h, bool m)
+    : heap(h), minor(m), wide_slots(64, mtGC), old_slots(256, mtGC) {}
+};
+
+class JamFields : public BasicOopIterateClosure {
+  JamScanState* _state;
+  jam_vm_visit* _visit;
+  bool _follow;
+  uint64_t _slots[128];
+  size_t _count;
+public:
+  JamFields(JamScanState* state, jam_vm_visit* visit, bool follow)
+    : BasicOopIterateClosure(follow ? state->heap->ref_processor() : nullptr),
+      _state(state), _visit(visit), _follow(follow), _count(0) {}
+
+  void flush() {
+    if (_count != 0) {
+      jam_vm_fields(_visit, _slots, _count, _follow);
+      _count = 0;
+    }
+  }
+  void do_oop(narrowOop* p) override {
+    guarantee(_state->heap->is_in_reserved(p), "Expected an in-heap narrow slot");
+    uintptr_t delta = (uintptr_t)p - (uintptr_t)CompressedOops::base();
+    guarantee(delta % sizeof(narrowOop) == 0, "Jam pointer slot must be aligned");
+    if (!_follow && _state->minor && !_state->heap->is_in_young(p)) {
+      _state->old_slots.append(p);
+    }
+    _slots[_count++] = uint64_t(delta / sizeof(narrowOop));
+    if (_count == ARRAY_SIZE(_slots)) flush();
+  }
+  void do_oop(oop* p) override {
+    guarantee(_state->heap->is_in_reserved(p), "Expected an in-heap wide slot");
+    if (!_follow) {
+      _state->wide_slots.append(p);
+    } else {
+      oop value = RawAccess<>::oop_load(p);
+      if (value != nullptr) {
+        uint32_t target = CompressedOops::narrow_oop_value(value);
+        jam_vm_targets(_visit, &target, 1);
+      }
+    }
+  }
+  ReferenceIterationMode reference_iteration_mode() override {
+    return _follow ? DO_DISCOVERY : DO_FIELDS;
+  }
+};
+
+static void jam_scan(void* raw, jam_vm_visit* visit, uint32_t at) {
+  JamScanState* state = static_cast<JamScanState*>(raw);
+  oop obj = CompressedOops::decode_not_null(CompressedOops::narrow_oop_cast(at));
+  size_t words = obj->size();
+  if (!jam_vm_claim(visit, at, words)) return;
+
+  // Relativize stack-internal pointers before the record becomes movable.
+  ContinuationGCSupport::transform_stack_chunk(obj);
+  JamFields declared(state, visit, false);
+  obj->oop_iterate(&declared);
+  declared.flush();
+  JamFields followed(state, visit, true);
+  obj->oop_iterate(&followed);
+  followed.flush();
+}
