+#endif
+
+JamBarrierSet::JamBarrierSet(CardTable* table) : CardTableBarrierSet(
+          make_barrier_set_assembler<CardTableBarrierSetAssembler>(),
+          make_barrier_set_c1<CardTableBarrierSetC1>(),
+          make_barrier_set_c2<CardTableBarrierSetC2>(),
+          table,
+          BarrierSet::FakeRtti(BarrierSet::JamBarrierSet)) {}
+
+void JamBarrierSet::on_thread_create(Thread *thread) {
+  JamThreadLocalData::create(thread, JamHeap::heap()->jam());
+  // The initial thread is created before the heap; set_barrier_set calls us
+  // later on that same thread. Other Thread objects are created by a parent.
+  if (thread == Thread::current_or_null()) {
+    on_thread_start(thread);
+  }
+}
+
+void JamBarrierSet::on_thread_destroy(Thread *thread) {
+  // Initialization may fail before attach/detach. Normal SMR destruction can
+  // run on a different thread and therefore must only free an inactive context.
+  if (JamThreadLocalData::context_active(thread)) {
+    JamThreadLocalData::leave(thread);
+  }
+  JamThreadLocalData::destroy(thread);
+}
+
+void JamBarrierSet::on_thread_start(Thread* thread) {
+  JamThreadLocalData::enter(thread);
+  assert(jam_vm_thread_current(JamHeap::heap()->jam()), "Jam heap must be bound on the executing OS thread");
+}
+
+void JamBarrierSet::on_thread_attach(Thread* thread) {
+  CardTableBarrierSet::on_thread_attach(thread);
+  // Threads::add for a Java-created thread executes on its creator. JNI
+  // attachment and NonJavaThread startup execute on the attached thread.
+  if (thread == Thread::current_or_null()) {
+    on_thread_start(thread);
+  }
+}
+
+void JamBarrierSet::on_thread_detach(Thread* thread) {
+  CardTableBarrierSet::on_thread_detach(thread);
+  JamThreadLocalData::leave(thread);
+}
