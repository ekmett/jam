+
+void JamHeap::trace_dirty_owners() {
+  if (_space->is_empty()) return;
+  GrowableArray<uint32_t> owners(256, mtGC);
+  HeapWord* scanned_end = _space->bottom();
+  CardTable::CardValue* end = _card_table->byte_after(_space->top() - 1);
+  for (CardTable::CardValue* card = _card_table->byte_for(_space->bottom()); card < end; ++card) {
+    if (*card == CardTable::clean_card_val()) continue;
+    HeapWord* card_start = _card_table->addr_for(card);
+    HeapWord* card_end = MIN2(card_start + CardTable::card_size_in_words(), _space->top());
+    if (card_end <= scanned_end) continue;
+    HeapWord* object = _old_starts->block_start_reaching_into_card(card_start);
+    // The BOT names the first block reaching into a card. Earlier dirty cards
+    // can already have submitted this object; discovery must see each owner once.
+    object = MAX2(object, scanned_end);
+    while (object < card_end) {
+      oop value = cast_to_oop(object);
+      HeapWord* next = object + value->size();
+      owners.append(CompressedOops::narrow_oop_value(value));
+      object = next;
+    }
+    scanned_end = object;
+  }
+  if (owners.length() != 0) {
+    jam_vm_trace_old(_jam, owners.adr_at(0), owners.length(), jam_scan, _jam_scan_state);
+  }
+}
