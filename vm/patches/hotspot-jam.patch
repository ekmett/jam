+    if (!CompressedOops::is_null(value)) {
+      _roots.append(CompressedOops::narrow_oop_value(value));
+    }
+  }
+public:
+  JamRoots() : _roots(1024, mtGC) {}
+  void do_oop(oop* p) override { apply(p); }
+  void do_oop(narrowOop* p) override { apply(p); }
+  void trace(JamHeap* heap) {
+    if (_roots.length() != 0) heap->trace_external(_roots.adr_at(0), _roots.length());
+  }
+};
