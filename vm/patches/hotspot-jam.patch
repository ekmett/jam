+class JamRemember : public BasicOopIterateClosure {
+  JamHeap* _heap;
+  CardTable* _cards;
+  bool _verify;
+  oop _owner;
+  template<class T> void apply(T* p) {
+    oop value = RawAccess<>::oop_load(p);
+    if (value != nullptr && _heap->is_in_young(value)) {
+      if (_verify) {
+        guarantee(*_cards->byte_for(p) != CardTable::clean_card_val() ||
+                  *_cards->byte_for(_owner) != CardTable::clean_card_val(),
+                  "Old-to-young edge at " PTR_FORMAT " lacks a card mark", p2i(p));
+      } else {
+        *_cards->byte_for(p) = CardTable::dirty_card_val();
+      }
+    }
+  }
+public:
+  JamRemember(JamHeap* heap, CardTable* cards, bool verify = false)
+    : _heap(heap), _cards(cards), _verify(verify), _owner(nullptr) {}
+  void set_owner(oop owner) { _owner = owner; }
+  void do_oop(oop* p) override { apply(p); }
+  void do_oop(narrowOop* p) override { apply(p); }
+  ReferenceIterationMode reference_iteration_mode() override { return DO_FIELDS; }
+};
+
+void JamHeap::rebuild_old_metadata(bool rebuild_cards) {
+  _card_table->clear_MemRegion(MemRegion(_space->bottom(), _space->end()));
+  JamRemember remember(this, _card_table);
+  for (HeapWord* object = _space->bottom(); object < _space->top();) {
+    oop value = cast_to_oop(object);
+    HeapWord* next = object + value->size();
+    _old_starts->update_for_block(object, next);
+    if (rebuild_cards) value->oop_iterate(&remember);
+    object = next;
+  }
+}
