+class JamCardTable : public CardTable {
+  JamHeap* _heap;
+public:
+  JamCardTable(MemRegion whole_heap, JamHeap* heap)
+    : CardTable(whole_heap), _heap(heap) {}
+  bool is_in_young(const void* p) const override { return _heap->is_in_young(p); }
+};
