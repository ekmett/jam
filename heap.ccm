/** \file
 * \brief A double-mapped word arena with bounded parallel compaction.
 * \defgroup jam_heap Word heap
 */
module;
#if defined(__linux__) && !defined(_GNU_SOURCE)
#define _GNU_SOURCE
#endif
#include <native/attributes.h>
#include <cstdio>
#include <cstdlib>
#include <algorithm>
#include <array>
#include <atomic>
