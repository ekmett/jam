export module jam:heap;
import :work;
import :compact;
export import :units;

namespace jam::detail {

native_cold native_noreturn
inline void heap_failure(char const * operation, int code = 0) noexcept {
  std::fprintf(stderr, "jam: %s (%d)\n", operation, code);
  std::abort();
}

/// \brief Two adjacent coherent views of one circular heap's backing pages.
/// \details Resizing aliases surviving pages rather than copying their contents.
class heap_mapping {
#if defined(_WIN32)
  struct backing {
    HANDLE handle;
    explicit backing(std::size_t bytes) noexcept
      : handle(::CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
          static_cast<DWORD>(bytes >> 32), static_cast<DWORD>(bytes), nullptr)) {
      if (!handle) system_failure("create heap backing");
    }
    ~backing() noexcept { ::CloseHandle(handle); }
  };
#endif
  struct span {
    std::size_t begin, end;
#if defined(_WIN32)
    std::shared_ptr<backing> section;
    std::size_t offset;
#endif
  };
  struct reservation {};
  std::byte * address = nullptr;
  std::size_t capacity = 0;
  // Linux's zero-old-size mremap must remain within one original VMA/object.
  std::vector<span> spans;

  [[noreturn]] static void system_failure(char const * operation) noexcept {
#if defined(_WIN32)
    heap_failure(operation, static_cast<int>(::GetLastError()));
#else
    heap_failure(operation, errno);
#endif
  }
  static void validate_size(std::size_t bytes) noexcept {
    if (!bytes || bytes % page_size() || bytes > std::numeric_limits<std::size_t>::max() / 2)
      heap_failure("capacity must be a nonzero whole-page size");
  }
  explicit heap_mapping(reservation, std::size_t bytes) noexcept {
    validate_size(bytes);
#if defined(_WIN32)
    auto const result = ::VirtualAlloc2(nullptr, nullptr, bytes * 2,
      MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, nullptr, 0);
    if (!result) system_failure("reserve heap placeholders");
#else
    auto const result = ::mmap(nullptr, bytes * 2, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (result == MAP_FAILED) system_failure("jam: reserve virtual memory");
#endif
    address = static_cast<std::byte *>(result);
    capacity = bytes;
  }
#if defined(_WIN32)
  static void alias(span const & source, std::byte * target, std::size_t count,
                    std::size_t offset = 0) noexcept {
    MEMORY_BASIC_INFORMATION region{};
    if (!::VirtualQuery(target, &region, sizeof(region))) system_failure("query heap placeholder");
    auto const begin = static_cast<std::byte *>(region.BaseAddress);
    auto const prefix = static_cast<std::size_t>(target - begin);
    if (prefix && !::VirtualFree(begin, prefix, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER))
      system_failure("split heap placeholder prefix");
    if (count < region.RegionSize - prefix &&
        !::VirtualFree(target, count, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER))
      system_failure("split heap placeholder suffix");
    if (!::MapViewOfFile3(source.section->handle, ::GetCurrentProcess(), target,
          source.offset + offset, count, MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE, nullptr, 0))
      system_failure("alias heap backing");
  }
#else
  static void alias(std::byte * source, std::byte * target, std::size_t count) noexcept {
#if defined(__APPLE__)
    auto destination = reinterpret_cast<mach_vm_address_t>(target);
    vm_prot_t current = 0, maximum = 0;
    auto const result = ::mach_vm_remap(::mach_task_self(), &destination, count, 0,
      VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, ::mach_task_self(),
      reinterpret_cast<mach_vm_address_t>(source), false, &current, &maximum, VM_INHERIT_SHARE);
    if (result != KERN_SUCCESS)
      heap_failure("alias virtual memory", result);
    assert(destination == reinterpret_cast<mach_vm_address_t>(target));
#else
    auto const result = ::mremap(source, 0, count, MREMAP_MAYMOVE | MREMAP_FIXED, target);
    if (result == MAP_FAILED) system_failure("jam: alias virtual memory");
    assert(result == target);
#endif
  }
#endif
  void fresh(std::size_t begin, std::size_t count) noexcept {
    if (!count) return;
#if defined(_WIN32)
    spans.push_back({begin, begin + count, std::make_shared<backing>(count), 0});
    alias(spans.back(), address + begin, count);
#else
    auto const result = ::mmap(address + begin, count, PROT_READ | PROT_WRITE,
      MAP_FIXED | MAP_SHARED | MAP_ANONYMOUS, -1, 0);
    if (result == MAP_FAILED) system_failure("jam: map fresh backing");
    spans.push_back({begin, begin + count});
#endif
  }
  void finish_aliases() noexcept {
    std::sort(spans.begin(), spans.end(), [](auto const & a, auto const & b) noexcept { return a.begin < b.begin; });
    for (auto const & s : spans)
#if defined(_WIN32)
      alias(s, address + capacity + s.begin, s.end - s.begin);
#else
      alias(address + s.begin, address + capacity + s.begin, s.end - s.begin);
#endif
  }
  void discard_gap(std::size_t start, std::size_t live) const noexcept {
#if defined(_WIN32)
    // Advisory discard releases dead physical pages; a partially retained section
    // keeps its commit charge until the last surviving view/handle is released.
    for (auto const & s : spans) {
      auto const discard = [&](std::size_t begin, std::size_t end) noexcept {
        begin = std::max(begin, s.begin);
        end = std::min(end, s.end);
        if (begin < end) static_cast<void>(::VirtualAlloc(address + begin, end - begin, MEM_RESET, PAGE_READWRITE));
      };
      if (start + live <= capacity) {
        discard(0, start);
        discard(start + live, capacity);
      } else discard(start + live - capacity, start);
    }
#else
    auto const begin = (start + live) % capacity;
    auto const count = capacity - live;
    auto const first = std::min(count, capacity - begin);
#if defined(__APPLE__)
    constexpr auto advice = MADV_FREE_REUSABLE;
#else
    constexpr auto advice = MADV_REMOVE;
#endif
    // dev: advisory release; kernels may retain dead pages until memory pressure.
    if (first) static_cast<void>(::madvise(address + begin, first, advice));
    if (count > first) static_cast<void>(::madvise(address, count - first, advice));
#endif
  }

public:
  /// \brief Reserve \p bytes of backing and twice that amount of virtual space.
  explicit heap_mapping(std::size_t bytes) noexcept : heap_mapping(reservation{}, bytes) {
    spans.reserve(1);
    fresh(0, bytes);
    finish_aliases();
  }
  heap_mapping(heap_mapping const &) = delete;
  heap_mapping & operator=(heap_mapping const &) = delete;
  heap_mapping(heap_mapping && other) noexcept
    : address(std::exchange(other.address, nullptr)), capacity(std::exchange(other.capacity, 0)),
      spans(std::move(other.spans)) {}
  heap_mapping & operator=(heap_mapping && other) noexcept { swap(other); return *this; }
  /// \brief Release both virtual views.
  ~heap_mapping() noexcept {
    if (!address) return;
#if defined(_WIN32)
    for (auto const & s : spans) {
      ::UnmapViewOfFile(address + s.begin);
      ::UnmapViewOfFile(address + capacity + s.begin);
    }
#else
    static_cast<void>(::munmap(address, capacity * 2));
#endif
  }
  /// \brief The first of the two adjacent views.
  std::byte * data() const noexcept { return address; }
  /// \brief Capacity of one view, in bytes.
  std::size_t bytes() const noexcept { return capacity; }
  /// \brief Native OS page size, also the mapping granularity.
  static std::size_t page_size() noexcept {
#if defined(_WIN32)
    SYSTEM_INFO info{};
    ::GetSystemInfo(&info);
    return info.dwPageSize;
#else
    return static_cast<std::size_t>(::getpagesize());
#endif
  }
  /// \brief Exchange mappings without moving payload bytes.
  void swap(heap_mapping & other) noexcept {
    std::swap(address, other.address);
    std::swap(capacity, other.capacity);
    spans.swap(other.spans);
  }
  /// \brief Resize by remapping the live circular arc to a new logical start.
  /// \details Starts must be page aligned. The final partial live page survives;
  /// the remaining gap gets fresh backing. Both old views remain usable until
  /// this object is destroyed; resizing may discard contents of its dead gap.
  heap_mapping resized(std::size_t old_start_bytes, std::size_t live_bytes,
                       std::size_t new_bytes, std::size_t new_start_bytes) const noexcept {
    validate_size(new_bytes);
    auto const page = page_size();
    if (!address || old_start_bytes >= capacity || new_start_bytes >= new_bytes ||
        old_start_bytes % page || new_start_bytes % page ||
        live_bytes > capacity || live_bytes > new_bytes)
      heap_failure("invalid circular remap range");
    auto const live = ((live_bytes + page - 1) / page) * page;
    heap_mapping result(reservation{}, new_bytes);
    result.spans.reserve(spans.size() + 4);
    auto source = old_start_bytes;
    auto target = new_start_bytes;
    auto remaining = live;
    while (remaining) {
      auto const where = std::lower_bound(spans.begin(), spans.end(), source,
        [](span const & s, std::size_t value) noexcept { return s.end <= value; });
      assert(where != spans.end() && where->begin <= source);
      auto const count = std::min({remaining, where->end - source, new_bytes - target});
#if defined(_WIN32)
      alias(*where, result.address + target, count, source - where->begin);
      result.spans.push_back({target, target + count, where->section, where->offset + source - where->begin});
#else
      alias(address + source, result.address + target, count);
      result.spans.push_back({target, target + count});
#endif
      source = (source + count) % capacity;
      target = (target + count) % new_bytes;
      remaining -= count;
    }
    if (!live) result.fresh(0, new_bytes);
    else if (new_start_bytes + live <= new_bytes) {
      result.fresh(0, new_start_bytes);
      result.fresh(new_start_bytes + live, new_bytes - new_start_bytes - live);
    } else result.fresh(new_start_bytes + live - new_bytes, new_bytes - live);
    result.finish_aliases();
    discard_gap(old_start_bytes, live);
    return result;
  }
};
}

namespace jam {

export class heap;
export template<class T> class root;
export template<class T> class ptr;

/// \brief A visitor for jam's compressed, alignment-preserving heap.
/// \ingroup jam_heap
export template<class V>
concept visitor = std::same_as<typename V::heap_type, heap>;

namespace detail {
#if defined(JAM_CONTEXT_X28)
#if !defined(__aarch64__)
#error "JAM_CONTEXT_X28 requires AArch64 and -ffixed-x28"
#endif
register heap * active_heap asm("x28");
#else
inline thread_local heap * active_heap = nullptr;
#endif
template<class T, class H = heap>
concept member_trace = requires(T & value, typename H::visitor & visit) {
  value.trace(visit);
};
template<class T, class H = heap>
concept cooperative_trace = requires(typename H::visitor & visit, ptr<T> at) {
  T::trace(visit, at);
};
template<class T>
concept has_trace = requires { &T::trace; } || member_trace<T> || cooperative_trace<T>;
}

/// \brief Bind an existing heap, restoring the previous binding on scope exit.
/// \ingroup jam_heap
/// The heap must outlive the scope. Scopes nest on one thread and may re-enter
/// a heap. They neither own the heap nor synchronize access to it.
export class heap_scope {
  heap * previous;
public:
  /// \brief Use the supplied heap for implicit operations on this thread.
  explicit inline heap_scope(heap & arena) noexcept;
  /// \brief Restore the binding saved at construction.
  inline ~heap_scope() noexcept { detail::active_heap = previous; }
  heap_scope(heap_scope const &) = delete;
  heap_scope & operator=(heap_scope const &) = delete;
};

/// \brief A value with no outgoing managed references.
/// \ingroup jam_heap
/// Specializing tracer<T> by deriving from leaf<T> explicitly suppresses traversal.
/// Heap storage requirements are separate from this reference-free promise.
export template<class T>
struct leaf {
  /// \brief Visit no fields; allocation tracing still marks the complete extent.
  template<class Visitor>
  static constexpr void trace(Visitor &, T const &) noexcept {}
};

/// \brief Per-value tracing customization; values without a hook are leaves.
/// \ingroup jam_heap
/// Scalars and ordinary records without a trace member contain no managed edges
/// by convention. Records containing managed pointers must enumerate them in a trace member
/// or a tracer specialization. Trivial copyability does not enumerate fields.
export template<class T>
struct tracer : leaf<T> {};

/// \brief Forward a value hook or a cooperative allocation hook.
/// \ingroup jam_heap
/// Visit each live ptr by reference from the supplied value. Nested values share
/// the enclosing allocation's pointer mask. Static trace(visit, ptr<T>) owns
/// allocation claiming and may walk directly between records.
export template<class T> requires detail::has_trace<T>
struct tracer<T> {
  /// \brief Enumerate a value's parts and forward its member hook's result.
  template<class Visitor>
  static constexpr auto trace(Visitor & visit, T const & value)
      noexcept(noexcept(value.trace(visit))) -> decltype(value.trace(visit)) {
    return value.trace(visit);
  }
  /// \brief Forward an unclaimed target to its cooperative static hook.
  template<class Visitor>
  static constexpr decltype(auto) trace(Visitor & visit, ptr<T> at) noexcept
      requires requires { T::trace(visit, at); } {
    return T::trace(visit, at);
  }
};

namespace detail {
template<class T, class H>
concept traceable_in = requires(T const & value, typename H::visitor & visit) {
  sizeof(T);
  tracer<T>::trace(visit, value);
} || requires(ptr<T> at, typename H::visitor & visit) {
  sizeof(T);
  tracer<T>::trace(visit, at);
};
}

/// \brief T supports tracing after it is complete.
/// \ingroup jam_heap
/// Return types are unrestricted; collection currently uses the hook's effects.
export template<class T>
concept traceable = detail::traceable_in<T, heap>;

/// \brief A typed heap offset, with no root registration or ownership.
/// \ingroup jam_heap
/// \tparam T Target record type; it may be incomplete here. No runtime tag is stored.
/// Null is zero. Copies preserve the offset; only declared heap fields and
/// registered roots are forwarded. Using a pointer under a different heap is
/// undefined behavior; pointers carry no owner ID.
/// Outside the managed heap, do not retain a ptr for use across heap.collect().
/// Stack variables, external containers and loaded snapshots are not rewritten,
/// even if a root keeps the target alive. Obtain a fresh pointer from that root
/// after collection; only registered roots preserve external object identity.
export template<class T>
class ptr {
public:
  /// \brief Target record type.
  using element_type = T;
  /// \brief Eight-byte cell index, stored in exactly four bytes.
  using offset = std::uint32_t;

private:
  mutable offset position = 0;

public:
  /// \brief Construct a null reference.
  constexpr ptr() noexcept = default;
  /// \brief Implicitly construct a null pointer.
  constexpr ptr(std::same_as<std::nullptr_t> auto) noexcept {}
  /// \brief Name a record start in the matching heap; the caller supplies its type.
  explicit constexpr ptr(offset at) noexcept : position(at) {}
  /// \brief Read the cell offset; unregistered copies expire on collection.
  native_nodiscard native_inline native_pure
  constexpr offset get() const noexcept { return position; }
  /// \brief Whether the reference is nonnull.
  native_inline native_pure
  explicit constexpr operator bool() const noexcept {
    return position != 0;
  }
  /// \brief Borrow the target in the current heap; expires on growth or collection.
  /// \pre This nonnull pointer belongs to the current heap.
  native_nodiscard T * operator->() const noexcept;
  /// \brief Borrow the target in the current heap.
  native_nodiscard T & operator*() const noexcept;
  /// \brief Prefetch the target's mark metadata without claiming or reading it.
  /// Null does nothing, even without a current heap. Nonnull pointers must belong
  /// to the current heap. This cache hint provides no synchronization.
  native_inline void prefetch_marks() const noexcept;
  /// \brief Prefetch the cache line containing the target's first byte for reading.
  /// Null does nothing, even without a current heap. Nonnull pointers must belong
  /// to the current heap. No target is claimed or dereferenced.
  native_inline void prefetch() const noexcept;
  /// \brief Order offsets within one heap; forwarding preserves surviving order.
  /// Compare fresh pointers after collection; unregistered copies still expire.
  constexpr auto operator<=>(ptr const &) const noexcept = default;
};

namespace detail {
template<class T> inline constexpr bool is_ptr = false;
template<class T> inline constexpr bool is_ptr<ptr<T>> = true;
template<class T, class Visitor>
concept visits = requires(Visitor & visit, std::remove_reference_t<T> const & value) {
  tracer<std::remove_cvref_t<T>>::trace(visit, value);
};
}

/// \brief Tag a reference slot and enqueue its target.
/// \ingroup jam_heap
export template<class T>
struct tracer<ptr<T>> {
  /// \brief Preserve the field address and dispatch to the matching heap visitor.
  template<visitor Visitor>
  static constexpr void trace(Visitor & visit, ptr<T> const & value)
      noexcept(noexcept(visit(value))) {
    visit(value);
  }
};

namespace detail {
template<class Visitor, class... Ts>
constexpr void trace_parts(Visitor & visit, Ts const &... values) noexcept {
  auto part = [&](auto const & value) constexpr noexcept {
    if constexpr (requires { visit(value); }) visit(value);
    else tracer<std::remove_cvref_t<decltype(value)>>::trace(visit, value);
  };
  (part(values), ...);
}
}

/// \brief Visit each tuple element in the enclosing allocation.
/// \ingroup jam_heap
export template<class... Ts>
struct tracer<std::tuple<Ts...>> {
  /// \brief Tuple views retain their elements' original addresses.
  template<class Visitor>
  static constexpr void trace(Visitor & visit, std::tuple<Ts...> const & value)
      requires (detail::visits<Ts, Visitor> && ...) {
    std::apply([&](auto const &... part) constexpr {
      detail::trace_parts(visit, part...);
    }, value);
  }
};

/// \brief Visit each array element in the enclosing allocation.
/// \ingroup jam_heap
export template<class T, std::size_t N>
struct tracer<std::array<T, N>> {
  /// \brief Visit elements in order, preserving their original addresses.
  template<class Visitor>
  static constexpr void trace(Visitor & visit, std::array<T, N> const & value)
      requires detail::visits<T, Visitor> {
    for (auto const & part : value) detail::trace_parts(visit, part);
  }
};

/// \brief Visit only the active variant alternative in the enclosing allocation.
/// \ingroup jam_heap
export template<class... Ts>
struct tracer<std::variant<Ts...>> {
  /// \brief A valueless variant has no outgoing managed fields.
  template<class Visitor>
  static constexpr void trace(Visitor & visit, std::variant<Ts...> const & value)
      requires (detail::visits<Ts, Visitor> && ...) {
    if (value.valueless_by_exception()) return;
    std::visit([&](auto const & part) constexpr {
      detail::trace_parts(visit, part);
    }, value);
  }
};

/// \brief Construction and collection policy. The worker count includes the caller.
/// \ingroup jam_heap
export struct heap_options {
  /// \brief Initial capacity in pages, including the reserve.
  units::pages capacity = 1_MiB;
  /// \brief Reserved pages for bounded compaction.
  units::pages reserve = units::ceil<units::pages>(256_KiB);
  /// \brief Maximum workers for both collection phases, including the caller.
  std::size_t workers = 1;
  /// \brief Shrink below 1/2^shift occupancy; two means 1/4, zero disables it.
  unsigned shrink_shift = 2;
};

/** \brief A circular, double-mapped arena with bounded parallel compaction.
 * \ingroup jam_heap
 * Compressed four-byte offsets address up to 32 GiB. Record alignment up to
 * 64 bytes is retained by dilation and padding between independent rank blocks.
 * Allocation and liveness always use eight-byte cells. Clients trace complete
 * relocatable records; the heap does not infer boundaries or run destructors.
 * Multiple markers may trace a frozen heap. Join them before compaction,
 * mutation, allocation, or inspecting metadata. Borrows expire on movement.
 */
export class heap {
  template<class T> friend class ptr;

public:
  /// \brief Read the current thread's dynamically bound heap.
  /// Implicit operations require an active heap_scope. Binding stores invalidate
  /// this pure accessor; it is not const and may change between scopes.
  native_nodiscard native_pure native_inline
  static heap * current() noexcept { return detail::active_heap; }

  /// \brief Eight-byte allocation cell. \ingroup jam_heap
  using word = std::uint64_t;
  /// \brief Stored reference, in eight-byte units from data(). \ingroup jam_heap
  using offset = std::uint32_t;
  /// \brief Allocation/live bitmap. \ingroup jam_heap
  using bitmap = offset;
  /// \brief Unreachable reference preserved by forwarding. \ingroup jam_heap
  static constexpr offset null = 0;
  /// \brief Eight-byte cells in one rank block: 32. \ingroup jam_heap
  static constexpr std::size_t block_words = 32;
  /// \brief Four-byte pointer fields per allocation cell. \ingroup jam_heap
  static constexpr unsigned fields_per_word = 2;
  /// \brief Live bitmap, forwarding base and pointer-field bitmap. \ingroup jam_heap
  using block = detail::heap_block;
  /// \brief The compact pointer type for this heap.
  /// \ingroup jam_heap
  template<class T> using ptr = jam::ptr<T>;
  static_assert(sizeof(std::size_t) == 8, "jam requires 64-bit addressing");
  static_assert(sizeof(block) == 16);
  static_assert(std::atomic_ref<bitmap>::is_always_lock_free);
  static_assert(std::atomic_ref<word>::is_always_lock_free);

  class visitor;

private:
  using trace_function = void (*)(visitor &, offset);
  struct trace_job { offset at; trace_function trace; };

public:
  /** \brief An external intrusive root, rewritten by each moving collection.
   * \ingroup jam_heap
   * Copies attach independent hooks; moves transfer the hook without allocating.
   * The owning heap must outlive every attached root_handle, including attached null pointers.
   * Root construction, assignment and destruction require a quiescent collector.
   */
  class root_handle {
    friend class heap;
    heap * owner = nullptr;
    mutable root_handle * previous = nullptr;
    mutable root_handle * next = nullptr;
    mutable offset position = null;
    trace_function trace = nullptr;

    void detach() noexcept {
      if (!owner) return;
      owner->require_mutator();
      if (previous) previous->next = next;
      else owner->roots_head = next;
      if (next) next->previous = previous;
      owner = nullptr;
      previous = next = nullptr;
      position = null;
      trace = nullptr;
    }
    void attach(heap * arena, offset at, trace_function fn) noexcept {
      if (!arena) return;
      arena->require_mutator();
      owner = arena;
      position = at;
      trace = fn;
      next = owner->roots_head;
      if (next) next->previous = this;
      owner->roots_head = this;
    }
    void take(root_handle & other) noexcept {
      if (!other.owner) return;
      other.owner->require_mutator();
      owner = std::exchange(other.owner, nullptr);
      position = std::exchange(other.position, null);
      trace = std::exchange(other.trace, nullptr);
      previous = std::exchange(other.previous, nullptr);
      next = std::exchange(other.next, nullptr);
      if (previous) previous->next = this;
      else owner->roots_head = this;
      if (next) next->previous = this;
    }
    root_handle(heap & arena, offset at, trace_function fn = nullptr) noexcept {
      attach(&arena, at, fn);
    }

  public:
    /// \brief Construct a null root_handle with no heap attachment.
    root_handle() noexcept = default;
    /// \brief Register a second root with the same owner and offset.
    root_handle(root_handle const & other) noexcept { attach(other.owner, other.position, other.trace); }
    /// \brief Transfer registration, leaving the source detached and null.
    root_handle(root_handle && other) noexcept { take(other); }
    /// \brief Replace registration, including transfer between heaps.
    root_handle & operator=(root_handle const & other) noexcept {
      if (this != &other) { detach(); attach(other.owner, other.position, other.trace); }
      return *this;
    }
    /// \brief Transfer registration, detaching the previous root.
    root_handle & operator=(root_handle && other) noexcept {
      if (this != &other) { detach(); take(other); }
      return *this;
    }
    /// \brief Unregister this root without touching its heap record.
    ~root_handle() noexcept { detach(); }
    /// \brief Read the current offset; the returned value expires on collection.
    native_nodiscard offset get() const noexcept { return position; }
    /// \brief Read the current offset, as with get().
    native_nodiscard offset operator*() const noexcept { return position; }
    /// \brief Whether this root currently names a record.
    explicit operator bool() const noexcept { return position != null; }
  };

  /** \brief One marker's claim and edge-discovery interface.
   * \ingroup jam_heap
   * Only a successful claimant visits the record's fields. The visitor is
   * borrowed for one callback and must not escape it.
   */
  class visitor {
    friend class heap;
    heap & arena;
    detail::frontier<trace_job> & pending;
    std::size_t worker;
    void const * record = nullptr;
    std::size_t record_bytes = 0;
    visitor(heap & h, detail::frontier<trace_job> & tasks, std::size_t id) noexcept
        : arena(h), pending(tasks), worker(id) {}

  public:
    /// \brief Heap accepted by this visitor.
    using heap_type = heap;
    visitor(visitor const &) = delete;
    visitor & operator=(visitor const &) = delete;
    /// \brief Claim a complete record; exactly one marker wins traversal.
    /// \pre All tracers agree on disjoint record starts, extents and alignments.
    native_nodiscard native_inline bool claim(offset start, std::size_t words = 1,
                               std::size_t alignment_bytes = 8) noexcept {
      return arena.claim(start, words, alignment_bytes);
    }
    /// \brief Claim a typed target without declaring the pointer's source slot.
    /// \return Its in-place address, or nullptr for null or an earlier claim.
    /// A successful claim makes this the current record for pointer declarations.
    /// Decorate its outgoing slots before claiming another target. Failure leaves
    /// the current record unchanged; the returned address cannot escape marking.
    template<class T>
    native_nodiscard native_inline T const * claim_target(ptr<T> value) noexcept {
      heap::require_record<T>();
      if (!value || !claim(value.get(), record_words<T>, std::max(alignof(T), sizeof(word))))
        return nullptr;
      auto const * result = arena.template record_address<T>(value.get());
      record = result;
      record_bytes = sizeof(T);
      return result;
    }
    /// \brief Declare one pointer slot without following or claiming its target.
    /// \pre The field is a subobject of the current successfully claimed record.
    template<class T>
    native_inline void pointer(ptr<T> const & value) noexcept {
      auto const address = reinterpret_cast<std::uintptr_t>(&value);
      auto const begin = reinterpret_cast<std::uintptr_t>(record);
      auto const delta = address - begin;
      if (!record || address < begin || record_bytes < sizeof(offset)
          || delta > record_bytes - sizeof(offset) || delta % sizeof(offset))
        detail::heap_failure("typed visitor requires a field in its tracing value");
      auto const heap_delta = address - reinterpret_cast<std::uintptr_t>(arena.data());
      arena.pointer(static_cast<offset>(heap_delta / sizeof(word)),
                    static_cast<unsigned>((heap_delta % sizeof(word)) / sizeof(offset)));
    }
    /// \brief OR a pattern of pointer slots into the current record's metadata.
    /// Bit zero names the 32-bit slot at first_slot, relative to the record start.
    /// Zero bits leave existing declarations unchanged. No targets are claimed.
    /// \pre Every set bit names a complete managed pointer field in this record.
    native_inline void pointers(word bits, std::size_t first_slot = 0) noexcept {
      if (!bits) return;
      auto const slots = record_bytes / sizeof(offset);
      if (!record || first_slot > slots
          || static_cast<std::size_t>(std::bit_width(bits)) > slots - first_slot)
        detail::heap_failure("pointer pattern exceeds its tracing value");
      auto const slot = (reinterpret_cast<std::uintptr_t>(record)
          - reinterpret_cast<std::uintptr_t>(arena.data())) / sizeof(offset) + first_slot;
      constexpr auto width = block_words * fields_per_word;
      auto const shift = slot % width;
      std::atomic_ref<word>{arena.metadata[slot / width].pointers}
          .fetch_or(bits << shift, std::memory_order_relaxed);
      if (shift && (bits >> (width - shift)))
        std::atomic_ref<word>{arena.metadata[slot / width + 1].pointers}
            .fetch_or(bits >> (width - shift), std::memory_order_relaxed);
    }
    /// \brief Declare a pointer slot, then claim its target as with claim_target().
    /// Null and already-claimed targets still have their source slot declared.
    template<class T>
    native_nodiscard native_inline T const * claim(ptr<T> const & value) noexcept {
      pointer(value);
      return claim_target(value);
    }
    /// \brief Declare a managed field and enqueue its nonnull target for tracing.
    /// \return The stored offset, usable until compaction starts.
    /// \pre The field belongs to the complete record just successfully claimed.
    native_inline offset field(offset cell, unsigned slot = 0) noexcept {
      arena.pointer(cell, slot);
      auto const target = arena.field(cell, slot);
      if (target != null) pending.push(worker, {target, nullptr});
      return target;
    }
    /// \brief Walk an embedded value without claiming cells again.
    /// Parts share the current allocation's pointer mask. Tuple views may name
    /// those parts, but ptr fields must retain their original heap addresses.
    template<class T>
    native_inline void operator()(T const & value) noexcept
        requires (!detail::is_ptr<T>) && detail::visits<T, visitor> {
      tracer<T>::trace(*this, value);
    }
    /// \brief Declare a typed field and enqueue its nonnull target.
    /// \pre The field is a subobject of the supplied tracing value, not a copy.
    /// The field's type supplies both its width and target type. A null field is
    /// declared but follows no target. The return value expires on collection.
    template<class T>
    native_inline ptr<T> operator()(ptr<T> const & value) noexcept {
      // Defer target validation until use: deducing a recursive member hook's
      // return type must not require that hook's own traceable constraint.
      static_assert(traceable<T>, "reference target must support tracing");
      pointer(value);
      if (value) pending.push(worker, {value.get(), &heap::template trace_record<T>});
      return value;
    }
    /// \brief Visit parts in order, preserving their addresses; an empty pack does nothing.
    template<class... Ts>
    native_inline void operator()(Ts const &... values) noexcept
        requires (sizeof...(Ts) != 1) && (detail::visits<Ts, visitor> && ...) {
      detail::trace_parts(*this, values...);
    }
    /// \brief Service overdue stochastic donations without leaving this walker.
    /// Long cooperative hooks should poll periodically after enqueueing branches.
    native_inline void poll() noexcept { pending.communicate(worker); }
  };

private:
  template<class T>
  static constexpr std::size_t record_words = (sizeof(T) + sizeof(word) - 1) / sizeof(word);

  template<class T>
  static constexpr void require_record() noexcept {
    static_assert(std::is_trivially_copyable_v<T> && std::is_trivially_copy_constructible_v<T>
                  && std::is_standard_layout_v<T>
                  && !std::is_const_v<T> && !std::is_volatile_v<T>,
                  "jam typed records must be unqualified, trivially copyable and copy constructible standard-layout types");
    static_assert(alignof(T) <= 64, "record alignment exceeds 64 bytes");
  }

  // The mutator or the unique successful marker owns typed lifetime restoration.
  // Marking never changes mappings; no payload copy or stack snapshot is needed.
  template<class T>
  native_inline T * record_address(offset at) noexcept {
    require_record<T>();
    assert(at && at < cursor && record_words<T> <= cursor - at);
    auto * p = data() + at;
    // As in typed mutator access, memmove starts implicit object lifetimes after
    // VM remapping or cell relocation. The self-copy is optimized away.
    return static_cast<T *>(std::memmove(p, p, sizeof(T)));
  }

  template<class T>
  static void trace_record(visitor & visit, offset at) noexcept {
    require_record<T>();
    static_assert(traceable<T>, "tracing hooks must accept the heap visitor");
    if constexpr (requires { tracer<T>::trace(visit, ptr<T>{at}); }) {
      // Cooperative hooks receive an unclaimed entry and own the walk.
      tracer<T>::trace(visit, ptr<T>{at});
    } else if (auto const * value = visit.claim_target(ptr<T>{at})) {
      tracer<T>::trace(visit, *value);
    }
  }

  struct settings { std::size_t page_words, reserved, minimum, bytes; heap_options policy; };
  heap_options const policy;
  detail::compactor const compactor = detail::choose_compactor();
  detail::work_pool workers;
  std::size_t const page_word_count;
  std::size_t const reserve_word_count;
  std::size_t const minimum_capacity;
  detail::heap_mapping storage;
  word * view_base;
  std::vector<block> metadata;
  // One alignment nibble per 256 bytes.
  // Low3 bits are a thermometer exponent (0,1,3,7); bit3 joins the next block.
  // Atomic OR therefore implements max(k), even for simultaneous markers.
  std::vector<std::uint8_t> alignment;
  std::size_t cursor = 1;
  std::size_t origin = 0;
  root_handle * roots_head = nullptr;
  bool collecting = false;
  void require_mutator() const noexcept {
    if (collecting) detail::heap_failure("mutation during collection");
  }
  static constexpr unsigned block_shift = 5;
  static constexpr std::size_t maximum_bytes = std::size_t{1} << 35;

  static constexpr bool valid_options(heap_options const & config) noexcept {
    return config.capacity.count() != 0 && config.capacity <= units::bytes{maximum_bytes}
        && config.reserve.count() != 0 && config.reserve <= units::bytes{maximum_bytes / 2}
        && config.workers != 0
        && config.shrink_shift < std::numeric_limits<std::size_t>::digits;
  }
  static settings configure(heap_options config) {
    if (config.capacity > units::bytes{maximum_bytes} || config.reserve > units::bytes{maximum_bytes})
      throw std::length_error("jam heap exceeds 32 GiB");
    constexpr auto page = static_cast<std::size_t>(units::pages::ratio::num);
    if (detail::heap_mapping::page_size() != page)
      detail::heap_failure("platform page size differs from build invariant");
    if (!valid_options(config) || page < 512 || page > maximum_bytes || !std::has_single_bit(page))
      detail::heap_failure("invalid byte sizes, page size or worker count");
    if (config.reserve > config.capacity / 2)
      detail::heap_failure("capacity must hold twice the reserve");
    auto const capacity = units::bytes{config.capacity}.count();
    auto const reserve = units::bytes{config.reserve}.count();
    return {page / 8, reserve / 8, 2 * reserve / 8, capacity, config};
  }
  explicit heap(settings s) noexcept
      : policy(s.policy), workers(policy.workers),
        page_word_count(s.page_words), reserve_word_count(s.reserved),
        minimum_capacity(s.minimum), storage(s.bytes),
        view_base(reinterpret_cast<word *>(storage.data())), metadata(s.bytes / (8 * block_words)) {
    alignment.resize((metadata.size() + 1) / 2);
  }
  static unsigned exponent(std::size_t bytes) noexcept {
    if (!std::has_single_bit(bytes) || bytes < 8 || bytes > 64u)
      detail::heap_failure("unsupported record alignment");
    return std::countr_zero(bytes) - 3;
  }
  unsigned flags(std::size_t index) const noexcept {
    return (alignment[index >> 1] >> ((index & 1) * 4)) & 15;
  }
  native_inline void add_flags(std::size_t index, unsigned bits) noexcept {
    std::atomic_ref<std::uint8_t>{alignment[index >> 1]}.fetch_or(
        static_cast<std::uint8_t>(bits << ((index & 1) * 4)), std::memory_order_relaxed);
  }
  native_inline void note_record(offset first, std::size_t words, std::size_t bytes) noexcept {
    assert(std::has_single_bit(bytes) && bytes >= 8 && bytes <= 64);
    assert((static_cast<std::size_t>(first) * 8) % bytes == 0);
    if (!words) return;
    auto const k = std::countr_zero(bytes) - 3;
    if (k) add_flags(first >> block_shift, (1u << k) - 1);
    auto const last = (static_cast<std::size_t>(first) + words - 1) >> block_shift;
    for (auto i = static_cast<std::size_t>(first) >> block_shift; i < last; ++i) add_flags(i, 8);
  }
  native_inline void mark_range(offset first, std::size_t words) noexcept {
    while (words != 0) {
      auto const bit = static_cast<std::size_t>(first & (block_words - 1));
      auto const count = std::min(words, block_words - bit);
      std::atomic_ref<bitmap>{metadata[first >> block_shift].live}.fetch_or(
          static_cast<bitmap>((~bitmap{0} >> (block_words - count)) << bit), std::memory_order_relaxed);
      first += static_cast<offset>(count);
      words -= count;
    }
  }
  static word pointer_cells(bitmap live) noexcept {
    word x = live;
    x = (x | (x << 16)) & 0x0000ffff0000ffffULL;
    x = (x | (x << 8)) & 0x00ff00ff00ff00ffULL;
    x = (x | (x << 4)) & 0x0f0f0f0f0f0f0f0fULL;
    x = (x | (x << 2)) & 0x3333333333333333ULL;
    x = (x | (x << 1)) & 0x5555555555555555ULL;
    return x | (x << 1);
  }
  static bitmap expand(bitmap live, unsigned k) noexcept {
    // OR across each 2^k-cell chunk, then fill it. No pdep loop on AArch64.
    for (unsigned shift = 1; shift < (1u << k); shift <<= 1) {
      word const low = ~word{0} / ((word{1} << shift) + 1);
      live = static_cast<bitmap>(live | ((live >> shift) & low) | ((live & low) << shift));
    }
    return live;
  }
  native_nodiscard offset base(block const & item) const noexcept {
    return item.destination;
  }
  native_nodiscard offset forward(offset value) const noexcept {
    if (value == null) return null;
    assert(value < cursor);
    auto const & item = metadata[value >> block_shift];
    auto const bit = static_cast<bitmap>(bitmap{1} << (value & (block_words - 1)));
    assert((item.live & bit) != 0);
    return base(item) + static_cast<offset>(std::popcount(static_cast<bitmap>(item.live & (bit - 1))));
  }
  void resize(std::size_t words) noexcept {
    assert(words % page_word_count == 0 && words >= minimum_capacity && words <= maximum_bytes / 8);
    assert(cursor <= words - reserve_word_count);
    std::vector<block> next_metadata(words / block_words);
    std::copy_n(metadata.begin(), (cursor + block_words - 1) / block_words, next_metadata.begin());
    auto const next_origin = words - reserve_word_count;
    auto next = storage.resized(origin * 8, cursor * 8, words * 8, next_origin * 8);
    alignment.resize((next_metadata.size() + 1) / 2);
    storage.swap(next); metadata.swap(next_metadata);
    origin = next_origin;
    view_base = reinterpret_cast<word *>(storage.data()) + origin;
  }

public:
  /// \brief Construct a heap and one persistent pool sized for both collection phases.
  /// \ingroup jam_heap
  /// \pre Capacity holds at least twice the reserve; workers are positive.
  /// \throws std::length_error if the requested capacity or reserve exceeds 32 GiB.
  /// Mapping/allocation/thread creation failures terminate; collection never unwinds.
  explicit heap(heap_options config = {})
      : heap(configure(config)) {}
  /// \brief Read the immutable construction policy with typed page counts. \ingroup jam_heap
  native_nodiscard heap_options configuration() const noexcept { return policy; }
  heap(heap const &) = delete;
  heap & operator=(heap const &) = delete;
  /// \brief Release the arena; every attached root must already be destroyed.
  ~heap() noexcept {
    if (roots_head) detail::heap_failure("heap destroyed with attached roots");
  }
  /// \brief Register a record or null as an intrusive public root.
  /// \pre A nonnull offset names an allocated record understood by the tracer.
  native_nodiscard root_handle root(offset at) noexcept {
    assert(at == null || at < cursor);
    return root_handle{*this, at};
  }
  /// \brief Register a typed external root with its type-specific tracing callback.
  /// \ingroup jam_heap
  /// \pre The reference is null or names a complete T in this heap.
  template<class T>
  native_nodiscard jam::root<T> root(ptr<T> at) noexcept requires traceable<T> {
    require_record<T>();
    assert(!at || at.get() < cursor);
    return jam::root<T>{root_handle{*this, at.get(), &heap::template trace_record<T>}};
  }
  /// \brief Trace typed roots and their typed edges, then compact.
  /// \ingroup jam_heap
  /// Nonnull untyped roots or untyped visitor.field edges require collect(trace).
  /// External ptr copies expire, including stack variables and loaded snapshots.
  /// Only registered roots retain their meaning; reacquire pointers from them.
  void collect() noexcept {
    collect([](visitor &, offset) noexcept { detail::heap_failure("untyped target in typed collection"); });
  }
  /** \brief Trace registered roots in parallel, then compact and rewrite them.
   * \ingroup jam_heap
   * \param trace A noexcept callable accepting visitor& and a record offset.
   * \pre Mutators are stopped, and the tracer permits concurrent invocation.
   * Compiler fences bracket the collection. Worker completion synchronizes
   * through the pool before forwarded roots and the new mapping become observable.
   * The tracer claims a complete record before visiting its outgoing fields.
   * Cycles and sharing terminate because only one claimant traverses each record.
   * Raw offsets and borrowed pointers expire on return; registered roots are updated.
   * External ptr copies on the stack or in containers and snapshots are not
   * rewritten, even when their targets survive. Reacquire them from roots.
   */
  template<class Trace>
  void collect(Trace && trace) noexcept
      requires std::is_nothrow_invocable_v<Trace &, visitor &, offset> {
    require_mutator();
    // Compiler-only safepoint: publish mutator stores before tracing. Worker
    // synchronization is supplied by the pool; this is not a hardware fence.
    std::atomic_signal_fence(std::memory_order_seq_cst);
    collecting = true;
    clear_marks();
    // Each collection redeclares fields: conditional tracers may change which
    // slots are references. Raw clear_marks()/compact() retain their old contract.
    for (auto & item : metadata) item.pointers = 0;
    std::vector<trace_job> initial;
    for (auto hook = roots_head; hook; hook = hook->next)
      if (hook->position != null) initial.push_back({hook->position, hook->trace});
    auto const marker_count = workers.available_workers();
    detail::frontier<trace_job> pending{marker_count, initial};
    struct context {
      heap * arena;
      std::remove_reference_t<Trace> * trace;
      detail::frontier<trace_job> * pending;
    } state{this, std::addressof(trace), &pending};
    workers.run(marker_count, [](void * raw, std::size_t worker) noexcept {
      auto & state = *static_cast<context *>(raw);
      heap_scope binding{*state.arena};
      visitor visit{*state.arena, *state.pending, worker};
      trace_job job;
      while (state.pending->pop(worker, job)) {
        if (job.trace) job.trace(visit, job.at);
        else std::invoke(*state.trace, visit, job.at);
      }
    }, &state);
    compact_impl({});
    collecting = false;
    std::atomic_signal_fence(std::memory_order_seq_cst);
  }
  /// \brief Allocate and copy a typed record, returning an unrooted reference.
  /// \ingroup jam_heap
  /// Construct T from the arguments. Register a root before collecting; copies
  /// of the returned ptr do not keep the target alive. Allocation preserves pointers.
  template<class T, class... Args>
  native_nodiscard ptr<T> mk(Args &&... args) noexcept requires traceable<T> {
    require_record<T>();
    static_assert(noexcept(T{std::forward<Args>(args)...}), "record construction must be noexcept");
    T const value{std::forward<Args>(args)...};
    auto const at = allocate(record_words<T>, std::max(alignof(T), sizeof(word)));
    std::fill_n(data() + at, record_words<T>, word{0});
    std::memcpy(data() + at, &value, sizeof(T));
    return ptr<T>{at};
  }
  /// \brief Borrow a typed target; the address expires on growth or collection.
  /// \ingroup jam_heap
  /// \pre The nonnull pointer names a complete record in this heap.
  /// Typed borrowing is a mutator operation; it requires exclusive record access.
  template<class T>
  native_nodiscard T * address(ptr<T> at) noexcept requires traceable<T> {
    require_record<T>();
    assert(!collecting);
    return record_address<T>(at.get());
  }
  /// \brief Read a typed value snapshot; any pointers in it expire on collection.
  /// \ingroup jam_heap
  /// \pre The reference names a complete T in this heap. No concurrent mutation.
  template<class T>
  native_nodiscard T load(ptr<T> at) const noexcept requires traceable<T> {
    require_record<T>();
    assert(at && at.get() < cursor && record_words<T> <= cursor - at.get());
    std::array<std::byte, sizeof(T)> bytes;
    std::memcpy(bytes.data(), data() + at.get(), sizeof(T));
    return std::bit_cast<T>(bytes);
  }
  /// \brief Replace a typed record's bytes without changing its extent or type.
  /// \ingroup jam_heap
  /// \pre The reference names a complete T in this heap; mutators are quiescent with GC.
  template<class T>
  void store(ptr<T> at, T const & value) noexcept requires traceable<T> {
    require_record<T>();
    require_mutator();
    assert(at && at.get() < cursor && record_words<T> <= cursor - at.get());
    std::memcpy(data() + at.get(), &value, sizeof(T));
  }
  /// \brief Capacity in eight-byte cells, including the reserve. \ingroup jam_heap
  native_nodiscard std::size_t capacity() const noexcept { return storage.bytes() / 8; }
  /// \brief Reserved cells for bounded parallel compaction. \ingroup jam_heap
  native_nodiscard std::size_t reserved() const noexcept { return reserve_word_count; }
  /// \brief Allocated prefix in eight-byte cells, including the reserved null cell. \ingroup jam_heap
  native_nodiscard std::size_t used() const noexcept { return cursor; }
  /// \brief Current view's offset in the circular backing, in cells. \ingroup jam_heap
  native_nodiscard std::size_t start() const noexcept { return origin; }
  /// \brief Cells per native OS page (distinct from a rank block). \ingroup jam_heap
  native_nodiscard std::size_t page_words() const noexcept { return page_word_count; }
  /// \brief Borrow cells; dereference an offset as data()[offset]. \ingroup jam_heap
  template<class Self>
  native_nodiscard native_inline native_pure
  auto data(this Self & self native_lifetimebound) noexcept
      -> std::conditional_t<std::is_const_v<Self>, word const, word> * {
    using cell = std::conditional_t<std::is_const_v<Self>, word const, word>;
    return static_cast<cell *>(self.view_base);
  }
  /// \brief Borrow an allocated cell. \ingroup jam_heap
  template<class Self>
  decltype(auto) operator[](this Self & self native_lifetimebound, offset index) noexcept {
    assert(index < self.cursor); return self.data()[index];
  }
  /** \brief Read one managed reference field by value.
   * \ingroup jam_heap
   * \param cell Eight-byte cell offset.
   * \param slot Zero or one.
   * Fixed-size byte copies permit both halves to coexist with whole-cell access.
   */
  native_nodiscard offset field(offset cell, unsigned slot = 0) const noexcept {
    assert(cell < cursor && slot < fields_per_word);
    offset value;
    auto const address = reinterpret_cast<std::byte const *>(data() + cell) + slot * sizeof(offset);
    std::memcpy(&value, address, sizeof(value));
    return value;
  }
  /** \brief Write a managed reference field's bytes.
   * \ingroup jam_heap
   * \param cell Eight-byte cell offset.
   * \param value Reference or null to store.
   * \param slot Zero or one.
   * Declare its pointer bit separately with pointer(). Mutation must not overlap
   * tracing or compaction; this operation does not synchronize field values.
   */
  void set_field(offset cell, offset value, unsigned slot = 0) noexcept {
    require_mutator();
    assert(cell < cursor && slot < fields_per_word);
    auto const address = reinterpret_cast<std::byte *>(data() + cell) + slot * sizeof(offset);
    std::memcpy(address, &value, sizeof(value));
  }
  /// \brief Borrow rank descriptors while markers and compaction are quiescent. \ingroup jam_heap
  native_nodiscard std::span<block const> blocks() const noexcept { return metadata; }
  /** \brief Allocate a positive complete record measured in eight-byte cells.
   * \ingroup jam_heap
   * \param words Extent, including any padding within the record.
   * \param alignment_bytes Alignment: 8, 16, 32 or 64 bytes.
   * Grows by doubling without copying payloads, capped at 32 GiB. Allocations preserve offsets.
   * Cell zero is reserved for null; leading alignment padding is initialized.
   * Resource failures terminate.
   */
  native_nodiscard offset allocate(std::size_t words, std::size_t alignment_bytes = 8) noexcept
      native_diagnose_if(words == 0, "jam records must contain at least one cell")
      native_diagnose_if(!std::has_single_bit(alignment_bytes) || alignment_bytes < 8 || alignment_bytes > 64u, "unsupported jam record alignment") {
    require_mutator();
    auto const k = exponent(alignment_bytes);
    auto const aligned = (cursor + (std::size_t{1} << k) - 1) & ~((std::size_t{1} << k) - 1);
    if (!words) detail::heap_failure("zero-word allocation");
    auto const limit = maximum_bytes / 8 - reserve_word_count;
    if (aligned > limit || words > limit - aligned)
      detail::heap_failure("capacity overflow");
    while (words > capacity() - reserve_word_count - std::min(aligned, capacity() - reserve_word_count))
      resize(std::min(capacity() * 2, maximum_bytes / 8));
    std::fill(data() + cursor, data() + aligned, word{0});
    cursor = aligned + words;
    return static_cast<offset>(aligned);
  }
  /// \brief Clear marks and alignment requirements; pointer declarations survive. \ingroup jam_heap
  void clear_marks() noexcept {
    for (auto & item : metadata) {
      item.live = 0;
      item.destination = 0;
    }
    std::fill(alignment.begin(), alignment.end(), 0);
  }
  /** \brief Mark a complete reachable record; concurrent markers are permitted.
   * \ingroup jam_heap
   * \param first Record start in cells.
   * \param words Complete extent in cells.
   * \param alignment_bytes Same alignment used to allocate this record.
   * \pre Extent is allocated and the heap is frozen. Join markers before moving.
   * Record boundaries prevent padding within straddling records.
   */
  void mark(offset first, std::size_t words = 1, std::size_t alignment_bytes = 8) noexcept {
    assert(first != null && first <= cursor && words <= cursor - first);
    note_record(first, words, alignment_bytes); mark_range(first, words);
  }
  /** \brief Claim traversal by atomically marking the record's first cell.
   * \ingroup jam_heap
   * \return Exactly one winning marker must trace this record's outgoing fields.
   * \pre Disjoint complete extents; all tracers agree on start, extent, alignment.
   * The start must not be independently marked. A claim is not completion;
   * join all markers before inspecting final marks or compacting.
   */
  native_nodiscard native_inline bool claim(offset first, std::size_t words = 1,
                           std::size_t alignment_bytes = 8) noexcept {
    assert(first != null && words && first < cursor && words <= cursor - first);
    auto const bit = static_cast<bitmap>(bitmap{1} << (first & (block_words - 1)));
    auto const previous = std::atomic_ref<bitmap>{metadata[first >> block_shift].live}
        .fetch_or(bit, std::memory_order_relaxed);
    if ((previous & bit) != 0) return false;
    note_record(first, words, alignment_bytes);
    mark_range(first + 1, words - 1);
    return true;
  }
  /** \brief Declare a managed reference field; may overlap frozen-heap markers.
   * \ingroup jam_heap
   * \param where Cell containing the field, rather than its target.
   * \param slot Zero or one.
   * Declarations survive until the containing cell is reclaimed. Unmarked fields
   * retained solely by dilation are copied as data, never forwarded.
   */
  native_inline void pointer(offset where, unsigned slot = 0) noexcept {
    assert(where != null && where < cursor && slot < fields_per_word);
    auto const bit = (where & (block_words - 1)) * fields_per_word + slot;
    std::atomic_ref<word>{metadata[where >> block_shift].pointers}
        .fetch_or(word{1} << bit, std::memory_order_relaxed);
  }
  /** \brief Pack marked records, forwarding managed fields and external roots.
   * \ingroup jam_heap
   * \param roots Mutable offsets outside the heap, including null.
   * The construction policy selects the participating workers, including the caller.
   * \pre Nonnull roots and live fields target marked cells. Mutators and markers
   * are stopped. Payloads are relocatable and roots do not alias the heap.
   * The view steps backward by the reserve. Copying never gets more than N
   * native source pages ahead of the earliest unfinished page; completed pages
   * release credit. Old rank descriptors remain frozen throughout copying.
   * Retained alignment groups and destination padding count toward used().
   * Shrink once below the configured occupancy threshold if live cells and reserve fit.
   * Resource failures terminate because a moving collection cannot unwind.
   */
  void compact(std::span<offset> roots = {}) noexcept {
    require_mutator();
    std::atomic_signal_fence(std::memory_order_seq_cst);
    collecting = true;
    compact_impl(roots);
    collecting = false;
    std::atomic_signal_fence(std::memory_order_seq_cst);
  }

private:
  void compact_impl(std::span<offset> roots) noexcept {
    // Keep the null cell in the packed prefix, including aligned collections.
    // It is padding, never a record or a source of outgoing pointers.
    data()[0] = 0;
    metadata[0].live |= bitmap{1};
    metadata[0].pointers &= ~word{(1u << fields_per_word) - 1};
    auto const old_blocks = (cursor + block_words - 1) / block_words;
    std::size_t live_words = 0;
    for (std::size_t begin = 0; begin < old_blocks;) {
      auto end = begin + 1;
      unsigned k = std::popcount(flags(begin) & 7u);
      while ((flags(end - 1) & 8u) && end < old_blocks) {
        k = std::max(k, static_cast<unsigned>(std::popcount(flags(end) & 7u))); ++end;
      }
      live_words = (live_words + (std::size_t{1} << k) - 1) & ~((std::size_t{1} << k) - 1);
      for (auto i = begin; i != end; ++i) {
        auto & item = metadata[i];
        item.pointers &= pointer_cells(item.live); // exact liveness, before dilation
        item.live = expand(item.live, k);
        item.destination = static_cast<offset>(live_words);
        live_words += std::popcount(item.live);
      }
      begin = end;
    }
    // Dilation can retain unallocated cells at the final record's rounded end.
    auto const padded = std::min(capacity() - reserve_word_count, (cursor + 7) & ~std::size_t{7});
    std::fill(data() + cursor, data() + padded, word{0});

    auto const next_origin = (origin + capacity() - reserve_word_count) % capacity();
    auto const source = data();
    auto const target = reinterpret_cast<word *>(storage.data()) + next_origin;
    auto const source_pages = (cursor + page_word_count - 1) / page_word_count;
    auto const wave_pages = reserve_word_count / page_word_count;
    auto move_page = [&](std::size_t page) noexcept {
      auto const begin = page * (page_word_count / block_words);
      auto const end = std::min(old_blocks, begin + page_word_count / block_words);
      compactor.move(source, target, metadata.data(), begin, end);
    };
    if (policy.workers > 1 && source_pages > 1) {
      auto done = std::make_unique<std::atomic<bool>[]>(source_pages);
      std::atomic<std::size_t> next{0}, front{0};
      auto task = [&](std::size_t) noexcept {
        for (;;) {
          auto const page = next.fetch_add(1, std::memory_order_relaxed);
          if (page >= source_pages) return;
          auto floor = front.load(std::memory_order_acquire);
          while (page - floor >= wave_pages) {
            front.wait(floor, std::memory_order_relaxed);
            floor = front.load(std::memory_order_acquire);
          }
          move_page(page);
          done[page].store(true, std::memory_order_release);
          // Every completion publishes through this RMW chain, even when an
          // older page still blocks the prefix. The last publisher therefore
          // sees all earlier done flags; a store-buffering cycle cannot stall.
          floor = front.fetch_add(0, std::memory_order_acq_rel);
          for (;;) {
            auto end = floor;
            while (end != source_pages && done[end].load(std::memory_order_acquire)) ++end;
            if (end == floor) break;
            if (front.compare_exchange_strong(floor, end, std::memory_order_acq_rel)) {
              front.notify_all(); break;
            }
            floor = front.load(std::memory_order_acquire);
          }
        }
      };
      workers.run(std::min(policy.workers, wave_pages),
        [](void * context, std::size_t i) noexcept {
          (*static_cast<decltype(task) *>(context))(i);
        }, &task);
    } else for (std::size_t page = 0; page < source_pages; ++page) move_page(page);
    for (auto & root : roots) root = forward(root);
    for (auto hook = roots_head; hook; hook = hook->next)
      hook->position = forward(hook->position);
    // Source-page workers never write destination gaps, so clear padding now.
    std::size_t previous_end = 0;
    for (std::size_t i = 0; i != old_blocks; ++i) {
      auto const next = static_cast<std::size_t>(base(metadata[i]));
      std::fill(target + previous_end, target + next, word{0});
      previous_end = next + std::popcount(metadata[i].live);
    }

    // Forwarding is finished. Reuse old descriptors for the packed field masks.
    // F(w)<=w means each nonzero output word is at most old block i: copy i's
    // descriptor first, then initialize/merge only already-consumed descriptors.
    auto const new_blocks = (live_words + block_words - 1) / block_words;
    compactor.pack(metadata.data(), old_blocks, new_blocks);
    for (std::size_t i = 0; i != old_blocks; ++i) {
      auto const words = i < new_blocks ? std::min(block_words, live_words - i * block_words) : 0;
      metadata[i].live = words ? static_cast<bitmap>(~bitmap{0} >> (block_words - words)) : 0;
      if (i >= new_blocks) metadata[i].pointers = 0;
      metadata[i].destination = 0;
    }
    std::fill(alignment.begin(), alignment.end(), 0);
    cursor = live_words; origin = next_origin; view_base = target;
    auto const smaller = std::max(minimum_capacity, (capacity() / page_word_count / 2) * page_word_count);
    if (policy.shrink_shift && smaller < capacity()
        && cursor < (capacity() >> policy.shrink_shift)
        && cursor <= smaller - reserve_word_count) resize(smaller);
  }
};

inline heap_scope::heap_scope(heap & arena) noexcept : previous(heap::current()) {
  detail::active_heap = &arena;
}

/// \brief A copyable external root, updated during collection.
/// \ingroup jam_heap
/// The owning heap must outlive the root. Copy and destruction use that owner,
/// even if another heap is bound. Dereference requires the owning heap current.
export template<class T>
class root : private heap::root_handle {
  using base = heap::root_handle;
  friend class heap;
  explicit root(base value) noexcept : base(std::move(value)) {}
public:
  /// \brief Construct a detached null root.
  root() noexcept = default;
  /// \brief Register a pointer with the current heap.
  /// \pre The pointer belongs to the current heap, which outlives this root.
  root(ptr<T> value) noexcept requires traceable<T> : root(heap::current()->root(value)) {}
  /// \brief Obtain a pointer valid until the next collection.
  native_nodiscard ptr<T> get() const noexcept { return ptr<T>{base::get()}; }
  /// \brief Copy the current pointer; this unrooted copy expires on collection.
  operator ptr<T>() const noexcept { return get(); }
  /// \brief Borrow the target in its current heap scope.
  native_nodiscard T * operator->() const noexcept { return get().operator->(); }
  /// \brief Borrow the target in its current heap scope.
  native_nodiscard T & operator*() const noexcept { return *get(); }
  /// \brief Whether this root currently names a record.
  explicit operator bool() const noexcept { return static_cast<bool>(get()); }
};

/// \brief Allocate a record in the current heap; register a root before collection.
export template<traceable T, class... Args>
native_nodiscard ptr<T> mk(Args &&... args) noexcept {
  return heap::current()->mk<T>(std::forward<Args>(args)...);
}

/// \brief Collect the current heap; only registered roots remain meaningful outside it.
export inline void collect() noexcept { heap::current()->collect(); }

template<class T>
T * ptr<T>::operator->() const noexcept {
  return heap::current()->address(*this);
}
template<class T>
T & ptr<T>::operator*() const noexcept { return *operator->(); }

template<class T>
native_inline void ptr<T>::prefetch_marks() const noexcept {
  if (!position) return;
  auto const * arena = heap::current();
  assert(arena && position < arena->cursor);
  __builtin_prefetch(&arena->metadata[position >> heap::block_shift].live, 0, 3);
}
template<class T>
native_inline void ptr<T>::prefetch() const noexcept {
  if (!position) return;
  auto const * arena = heap::current();
  assert(arena && position < arena->cursor);
  __builtin_prefetch(arena->view_base + position, 0, 3);
}
}
