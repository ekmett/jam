/// \file
/// \brief Rank metadata and the runtime-selected compactor interface.
module;
#include <hint.h>
#include <bit>
#include <cstddef>
#include <cstdint>
#include <span>
export module jam.packed;
import native.isa;

export namespace jam::detail {
struct heap_block {
  std::uint32_t live = 0; // Exact claims; retained alignment cells are derived.
  std::uint32_t destination = 0;
  std::uint64_t pointers = 0;
};

// Fill every 2^k-cell group containing a claimed cell, without changing claims.
[[nodiscard]] hint_inline constexpr std::uint32_t dilate(std::uint32_t live, unsigned k) noexcept {
  for (unsigned shift = 1; shift < (1u << k); shift <<= 1) {
    auto const low = ~std::uint32_t{0} / ((std::uint32_t{1} << shift) + 1);
    live |= ((live >> shift) & low) | ((live & low) << shift);
  }
  return live;
}

// Keep alignment padding before live cells, but no suffix after the last one.
// Target ranks are unchanged: forwarding only counts bits below a live target.
[[nodiscard]] hint_inline constexpr std::uint32_t retained(std::uint32_t live, unsigned k) noexcept {
  if (!k) return live;
  return dilate(live, k) & (~std::uint32_t{0} >> std::countl_zero(live | 1u));
}

// The low three bits of each nibble encode k as a thermometer (0, 1, 3, 7).
// Null means every k is zero. Tables are padded to complete dwords for gathers.
[[nodiscard]] hint_inline constexpr std::uint32_t retained(heap_block const & item,
    std::uint8_t const * alignment, std::size_t index) noexcept {
  if (!alignment) return item.live;
  auto const flags = (alignment[index >> 1] >> ((index & 1) * 4)) & 7u;
  return retained(item.live, std::popcount(flags));
}

// Null old metadata means an old target is stationary during a minor collection.
struct forwarding_tables {
  heap_block const * old;
  heap_block const * young;
  std::uint8_t const * old_alignment = nullptr;
  std::uint8_t const * young_alignment = nullptr;
};

// Dispatch remains per range, shared by both generations.
struct compactor {
  void (*move_impl)(std::uint64_t const *, std::uint64_t *, heap_block const *,
                    std::size_t, std::size_t, forwarding_tables, std::uint8_t const *) noexcept;
  void (*pack_impl)(heap_block const *, heap_block *, std::size_t, std::uint8_t const *) noexcept;
  native::isa<> requirement;
  char const * name;
  void move(std::uint64_t const * source, std::uint64_t * target, heap_block const * metadata,
            std::size_t begin, std::size_t end) const noexcept {
    move_impl(source, target, metadata, begin, end, {metadata, nullptr}, nullptr);
  }
  void move(std::uint64_t const * source, std::uint64_t * target, heap_block const * metadata,
            std::size_t begin, std::size_t end, forwarding_tables tables,
            std::uint8_t const * alignment = nullptr) const noexcept {
    move_impl(source, target, metadata, begin, end, tables, alignment);
  }
  void pack(heap_block const * metadata, heap_block * output, std::size_t count,
            std::uint8_t const * alignment = nullptr) const noexcept {
    pack_impl(metadata, output, count, alignment);
  }
};
}

export namespace jam::detail {
std::span<compactor const> compactor_variants() noexcept;
compactor choose_compactor() noexcept;
}
