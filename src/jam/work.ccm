#if defined(__APPLE__)
// Keep the SDK assert macro's implicit builtin declaration in the global
// module; otherwise Clang 23 imports competing declarations from native/jam.
extern "C" long __builtin_expect(long, long) noexcept;
#endif

export module jam.work;

export namespace jam::detail {

// A phase supplies a bounded number of long-lived callbacks. The caller is
// one worker; callbacks and their context remain borrowed until run returns.
class work_pool {
public:
  using callback = void (*)(void *, std::size_t) noexcept;

private:
  struct range {
    std::size_t begin;
    std::size_t end;
  };

  struct activation {
    activation * previous;
    inline static thread_local activation * current = nullptr;

    activation() noexcept : previous(current) { current = this; }
    ~activation() noexcept { current = previous; }
  };

  std::size_t const worker_count;
  std::mutex bulk_mutex;
  std::mutex scheduler_mutex;
  std::condition_variable ready;
  std::vector<std::optional<range>> mailboxes;
  callback function = nullptr;
  void * context = nullptr;
  std::size_t pending_count = 0;
  std::size_t remaining_count = 0;
  std::size_t chunk_grain = 1;
  // Threads must be destroyed before the synchronization state they use.
  std::vector<std::jthread> threads;

  [[nodiscard]]
  static bool executing_here() noexcept {
    return activation::current != nullptr;
  }

  static void execute(range work, callback fn, void * state) noexcept;

  // scheduler_mutex is held and pending_count > 0. Transfers preserve the
  // remaining count, which includes queued, claimed and executing indices.
  [[nodiscard]]
  range take(std::size_t worker) noexcept;

  void complete(range work) noexcept;

  void worker_loop(std::stop_token stop, std::size_t worker) noexcept;

  void stop_threads() noexcept;

public:
  explicit work_pool(std::size_t workers = 1) noexcept;

  work_pool(work_pool const &) = delete;
  work_pool & operator=(work_pool const &) = delete;
  ~work_pool() noexcept;

  [[nodiscard]]
  std::size_t workers() const noexcept { return worker_count; }

  // Nested pool launches execute serially: do not count unstarted markers.
  std::size_t available_workers() const noexcept {
    return executing_here() ? 1 : worker_count;
  }

  // External calls serialize. A nested call from any pool callback runs
  // inline, avoiding both same-pool and A -> B -> A waiting cycles.
  void run(std::size_t count, callback fn, void * state,
           std::size_t grain = 1) noexcept;
};

// Sender-initiated private queues: Acar/Chargueraud/Rainey, PPoPP 2013,
// Figure 3; PASL sched/workstealing.cpp (algorithm reference, not copied code).
// Unlike PASL's reset-to-now alarm, deadlines accumulate exponential intervals.
struct donation_clock {
  using clock = std::chrono::steady_clock;
  std::minstd_rand random;
  std::exponential_distribution<double> interval{1.0 / 30'000.0}; // nanoseconds
  clock::time_point deadline;

  explicit donation_clock(unsigned seed) noexcept
      : random(seed + 1), deadline(clock::now()) { advance(); }

  void advance() noexcept {
    // Rounding must never produce zero: catch-up must make forward progress.
    auto const ns = std::chrono::nanoseconds{
        std::max(std::int64_t{1}, static_cast<std::int64_t>(interval(random)))};
    deadline += std::max(clock::duration{1},
                        std::chrono::duration_cast<clock::duration>(ns));
  }

  template<class Attempt>
  void catch_up(clock::time_point now, Attempt attempt) noexcept {
    while (deadline <= now) {
      attempt();
      advance();
    }
  }
};

template<class Item>
class frontier {
  static_assert(std::is_trivially_copyable_v<Item>);
  enum class state : unsigned { running, idle, reserved, ready, stopped };
  struct alignas(64) mailbox {
    std::atomic<state> status{state::running};
    std::vector<Item> incoming;
  };
  struct alignas(64) local {
    std::vector<Item> pending;
    donation_clock timer;
    explicit local(unsigned seed) noexcept : timer(seed) {}
  };
  std::size_t const worker_count;
  std::unique_ptr<mailbox[]> mailboxes;
  std::vector<local> locals;
  // Counts active workers plus reserved/published transfers. A sender remains
  // active until after incrementing for its recipient and publishing the batch.
  // No atomics are touched by local queue mutation or record completion.
  std::atomic<std::size_t> active;

  bool acquire(std::size_t worker) noexcept {
    auto & box = mailboxes[worker];
    // Publishes completion of all previous reads of incoming. A sender must
    // acquire this idle epoch before it can reuse the vector (ARM as well as TSO).
    box.status.store(state::idle, std::memory_order_release);
    if (active.fetch_sub(1, std::memory_order_acq_rel) == 1) {
      // Every initial worker is counted, even before entering pop. Reserved
      // transfers are counted before ready is published. Zero is therefore
      // terminal: no sender or unstarted worker can still publish work.
      for (std::size_t i = 0; i != worker_count; ++i) {
        mailboxes[i].status.store(state::stopped, std::memory_order_release);
        mailboxes[i].status.notify_one();
      }
      return false;
    }
    for (;;) {
      auto const observed = box.status.load(std::memory_order_acquire);
      if (observed == state::stopped) return false;
      if (observed == state::ready) {
        // Acquire pairs with the donor's ready store; only this receiver reads
        // the published batch. No sender accesses it again until the next idle.
        locals[worker].pending.swap(box.incoming);
        box.status.store(state::running, std::memory_order_relaxed);
        return true;
      }
      box.status.wait(observed, std::memory_order_acquire);
    }
  }

public:
  explicit frontier(std::size_t workers, std::span<Item const> roots) noexcept
      : worker_count(std::max(workers, std::size_t{1})),
        mailboxes(std::make_unique<mailbox[]>(worker_count)), active(worker_count) {
    locals.reserve(worker_count);
    for (std::size_t i = 0; i != worker_count; ++i)
      locals.emplace_back(static_cast<unsigned>(i));
    for (std::size_t i = 0; i != roots.size(); ++i)
      locals[i % worker_count].pending.push_back(roots[i]);
  }
  frontier(frontier const &) = delete;
  frontier & operator=(frontier const &) = delete;

  native_inline void push(std::size_t worker, Item value) noexcept {
    locals[worker].pending.push_back(value);
  }

  // Only the owner accesses pending. A successful CAS reserves exclusive writer
  // access to an idle peer's inbox; failed attempts never modify either queue.
  bool donate(std::size_t worker, std::size_t peer) noexcept {
    auto & source = locals[worker].pending;
    if (source.size() < 2 || worker == peer) return false;
    auto & box = mailboxes[peer];
    auto expected = state::idle;
    if (!box.status.compare_exchange_strong(expected, state::reserved,
          std::memory_order_acquire, std::memory_order_relaxed)) return false;
    active.fetch_add(1, std::memory_order_relaxed);
    auto const half = source.size() / 2;
    // Keep the newest half for local DFS; transfer ownership of older work.
    box.incoming.assign(source.begin(), source.begin() + half);
    source.erase(source.begin(), source.begin() + half);
    box.status.store(state::ready, std::memory_order_release);
    box.status.notify_one();
    return true;
  }

  void communicate(std::size_t worker) noexcept {
    if (worker_count == 1) return;
    auto & timer = locals[worker].timer;
    while (timer.deadline <= donation_clock::clock::now()) {
      auto peer = std::uniform_int_distribution<std::size_t>{0, worker_count - 2}(timer.random);
      if (peer >= worker) ++peer;
      donate(worker, peer);
      timer.advance();
    }
  }

  bool pop(std::size_t worker, Item & result) noexcept {
    communicate(worker);
    auto & pending = locals[worker].pending;
    if (pending.empty() && !acquire(worker)) return false;
    result = pending.back();
    pending.pop_back();
    return true;
  }
};

}

namespace jam::detail {
void work_pool::execute(range work, callback fn, void * state) noexcept {
  activation scope;
  for (auto index = work.begin; index < work.end; ++index) fn(state, index);
}

work_pool::range work_pool::take(std::size_t worker) noexcept {
  if (!mailboxes[worker]) {
    for (std::size_t distance = 1; distance < worker_count; ++distance) {
      auto const victim = (worker + distance) % worker_count;
      auto & source = mailboxes[victim];
      if (!source) continue;
      auto & pending = *source;
      auto const size = pending.end - pending.begin;
      auto const split = size > chunk_grain ? pending.begin + size / 2
                                           : pending.begin;
      mailboxes[worker] = range{split, pending.end};
      if (split == pending.begin) source.reset();
      else pending.end = split;
      break;
    }
  }
  auto & pending = *mailboxes[worker];
  range const work{pending.begin,
                  pending.begin + std::min(chunk_grain, pending.end - pending.begin)};
  pending.begin = work.end;
  if (pending.begin == pending.end) mailboxes[worker].reset();
  pending_count -= work.end - work.begin;
  return work;
}

void work_pool::complete(range work) noexcept {
  bool finished;
  {
    std::lock_guard lock(scheduler_mutex);
    remaining_count -= work.end - work.begin;
    finished = remaining_count == 0;
  }
  if (finished) ready.notify_all();
}

void work_pool::worker_loop(std::stop_token stop, std::size_t worker) noexcept {
  for (;;) {
    std::unique_lock lock(scheduler_mutex);
    ready.wait(lock, [&] noexcept {
      return stop.stop_requested() || pending_count != 0;
    });
    if (stop.stop_requested()) return;
    auto const work = take(worker);
    auto const fn = function;
    auto * const state = context;
    lock.unlock();
    execute(work, fn, state);
    complete(work);
  }
}

void work_pool::stop_threads() noexcept {
  {
    std::lock_guard lock(scheduler_mutex);
    for (auto & thread : threads) thread.request_stop();
  }
  ready.notify_all();
  threads.clear();
}

work_pool::work_pool(std::size_t workers) noexcept
    : worker_count(std::max(workers, std::size_t{1})), mailboxes(worker_count) {
  threads.reserve(worker_count - 1);
  for (std::size_t worker = 1; worker < worker_count; ++worker)
    threads.emplace_back([this, worker](std::stop_token stop) noexcept {
      worker_loop(stop, worker);
    });
}

work_pool::~work_pool() noexcept { stop_threads(); }

void work_pool::run(std::size_t count, callback fn, void * state,
         std::size_t grain) noexcept {
  if (!count) return;
  assert(fn != nullptr);
  grain = std::max(grain, std::size_t{1});
  if (executing_here()) {
    execute({0, count}, fn, state);
    return;
  }
  std::lock_guard bulk_lock(bulk_mutex);
  if (worker_count == 1 || count <= grain) {
    execute({0, count}, fn, state);
    return;
  }
  {
    std::lock_guard lock(scheduler_mutex);
    mailboxes[0] = range{0, count};
    function = fn;
    context = state;
    chunk_grain = grain;
    pending_count = count;
    remaining_count = count;
  }
  ready.notify_all();
  for (;;) {
    std::unique_lock lock(scheduler_mutex);
    ready.wait(lock, [&] noexcept {
      return remaining_count == 0 || pending_count != 0;
    });
    if (remaining_count == 0) {
      function = nullptr;
      context = nullptr;
      return;
    }
    auto const work = take(0);
    lock.unlock();
    execute(work, fn, state);
    complete(work);
  }
}
}
